{
  "name": "northgate-kyc-copilot",
  "version": "1.0.0",
  "description": "Northgate KYC Copilot - Module A (Document Chaser) & Module B (Analyst Assist)",
  "scripts": {
    "setup": "python -m venv .venv && .venv\\Scripts\\pip install -r backend/requirements.txt && cd frontend && npm install",
    "seed": ".venv\\Scripts\\python -m backend.app.seed.seed_data",
    "dev:backend": ".venv\\Scripts\\uvicorn backend.app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": ".venv\\Scripts\\pytest backend/tests -v",
    "eval": ".venv\\Scripts\\python -m backend.eval.run_eval",
    "record-cache": ".venv\\Scripts\\python backend/scripts/record_demo_cache.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
